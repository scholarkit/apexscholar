# Apex Scholar Environment Configuration
# Copy this file to .env and fill in the values
VITE_PROVIDER=puter

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LaTeX Compilation: Powered by Tectonic (no external GitHub setup required)
# GITHUB_TOKEN, GITHUB_OWNER, GITHUB_REPO are no longer required for LaTeX.

# External API Keys
SERPAPI_API_KEY=your_serpapi_key_here
NCBI_API_KEY=your_ncbi_api_key_here

# Optional: AI Services
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Supermemory
SUPERMEMORY_API_KEY=your_supermemory_api_key_here

# Environment
NODE_ENV=development
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=