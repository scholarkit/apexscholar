    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.5.16",
    "clsx": "^2.1.1",
    "codemirror-lang-latex": "^0.2.0",
    "crypto-js": "^4.2.0",
    "d3-force": "^3.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
